# GitHub API URL (defaults to public API)
VITE_GITHUB_API_URL=https://api.github.com

# Backend API URL (e.g. https://git-explore-production.up.railway.app)
# Leave empty for local-only mode (reports will be saved to localStorage only)
VITE_API_URL=

# Cloudflare Turnstile Site Key for bot verification
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=
