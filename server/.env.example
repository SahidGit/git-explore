# ========================================
# GitExplorer Server Environment Variables
# ========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# Server
PORT=5000

# MongoDB Database Connection
# Example: mongodb://username:password@host:27017/gitexplorer
# For local development: mongodb://127.0.0.1:27017/gitexplorer
MONGODB_URI=mongodb://127.0.0.1:27017/gitexplorer

# CORS - Frontend Application Origin
# For local development: http://localhost:5173
# For production: https://your-deployed-frontend.com
CLIENT_ORIGIN=http://localhost:5173

# Optional GitHub Personal Access Token (PAT) for backend proxy
# Raises GitHub API rate limit from 60 requests/hr to 5,000 requests/hr
GITHUB_TOKEN=

# Cloudflare Turnstile Verification Keys (No login/signup required)
# Development always-pass testing keys:
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAFFCUQbda_xDcOsn
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAFFCUTz_Y2z8aUTw_ueRrn9-pco
