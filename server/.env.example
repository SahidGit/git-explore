# ========================================
# GitExplorer Server Environment Variables
# ========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# Server
PORT=5000

# MongoDB Database Connection
# Example: mongodb://username:password@host:27017/gitexplorer
# For local development: mongodb://127.0.0.1:27017/gitexplorer
MONGODB_URI=mongodb://127.0.0.1:27017/gitexplorer

# CORS - Frontend Application Origin
# For local development: http://localhost:5173
# For production: https://your-deployed-frontend.com
CLIENT_ORIGIN=http://localhost:5173

# GitHub API (Optional - for proxying GitHub requests)
# Leave empty to use default: https://api.github.com
# Can be set to a proxy URL if needed
GITHUB_API_URL=https://api.github.com

# GitHub Personal Access Token (Optional - for server-side API calls)
# Only set if your backend needs to call GitHub API with higher rate limits
# Never expose this in frontend code
GITHUB_TOKEN=

# ========================================
# Cloudflare Turnstile - Bot Protection
# ========================================
# For development: Use the test keys provided below
# For production: Get keys from https://dash.cloudflare.com/?to=/:account/turnstile

# Site Key (used in frontend)
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Secret Key (used in backend validation)
# IMPORTANT: Only the backend should have access to this
# DO NOT expose this in frontend or version control
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ========================================
# Production Deployment Notes
# ========================================
# When deploying to production:
# 1. Set MONGODB_URI to your cloud database (Atlas, etc.)
# 2. Update CLIENT_ORIGIN to your production frontend URL
# 3. Generate real Cloudflare Turnstile keys
# 4. Keep all secrets in your deployment platform's environment variables
# 5. NEVER hardcode secrets in .env files
