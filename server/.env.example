# ========================================
# GitExplorer Server Environment Variables
# ========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# Server
PORT=5000

# MongoDB Database Connection
# Example: mongodb://username:password@host:27017/gitexplorer
# For local development: mongodb://127.0.0.1:27017/gitexplorer
MONGODB_URI=mongodb://127.0.0.1:27017/gitexplorer

# CORS - Frontend Application Origin
# For local development: http://localhost:5173
# For production: https://exploregit.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Optional GitHub Personal Access Token (PAT) for backend proxy
# Raises GitHub API rate limit from 60 requests/hr to 5,000 requests/hr
GITHUB_TOKEN=

# Optional Distributed Rate Limiting (Upstash Redis REST API)
# Ensures shared rate limiting across serverless function instances on Vercel
# Create a free database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile Bot Verification Keys
# For local development / testing, use Cloudflare's public test keys:
# Site Key: 1x00000000000000000000AA (always passes)
# Secret Key: 1x0000000000000000000000000000000AA
# For production, obtain real credentials at: https://dash.cloudflare.com/?to=/:account/turnstile
# (Note: Test keys are rejected in production for security)
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
